<Window x:Class="G5Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LG G5" Icon="app.ico" Width="380" SizeToContent="Height"
        ResizeMode="CanMinimize" ShowInTaskbar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="20,16,20,20">
        <TextBlock Text="LG G5" FontSize="26" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Text="Verbinde …" Opacity="0.7" Margin="0,2,0,12" TextWrapping="Wrap" />
        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Hidden" Margin="0,0,0,12" />

        <ItemsControl x:Name="PresetList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Click="Preset_Click" Tag="{Binding}" Margin="0,0,0,8" Padding="14,12"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="24"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Header="Verbindung" Margin="0,4,0,0">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="IP-Adresse des Fernsehers" Opacity="0.7" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IpBox" VerticalContentAlignment="Center" KeyDown="IpBox_KeyDown" />
                    <Button Grid.Column="1" Content="Speichern" Click="SaveIp_Click" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="Suchen" Click="SearchIp_Click" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Expander>

        <CheckBox x:Name="AutostartBox" Content="Mit Windows starten (im Tray)" Margin="0,8,0,0"
                  Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
    </StackPanel>
</Window>
